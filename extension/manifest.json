{
  "manifest_version": 3,
  "name": "Meeting Companion AI",
  "version": "1.0.0",
  "description": "Captures meeting audio, streams to backend, and generates intelligent AI summaries.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.jpg"
  },
  "icons": {
    "128": "icon.jpg"
  }
}
